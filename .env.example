# Base de dados
# Dev rápido (SQLite) — não precisa de instalar nada:
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL) — muda também o provider em prisma/schema.prisma:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/nacional2"

# Auth.js
AUTH_SECRET="gera-com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Backblaze B2 (S3 compatível) — opcional; sem isto as fotos usam a ilustração
B2_ENDPOINT=""            # ex: https://s3.eu-central-003.backblazeb2.com
B2_REGION="eu-central-003"
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET=""
B2_PUBLIC_URL=""          # ex: https://f003.backblazeb2.com/file/o-teu-bucket

# API Carros PT (fonte secundaria / backup)
CARROS_API_BASE_URL="https://n2-py-scraper-production.up.railway.app"
CARROS_API_PAGE_SIZE="200"
CARROS_API_KEY=""         # so e necessaria para POST /scrape/run na API remota

# Instagram — opcional; sem isto o painel /admin/instagram só gera a imagem +
# legenda para descarregar e publicar à mão.
# A publicação por API também precisa do B2 configurado (o Instagram vai buscar
# a imagem a um URL público).
#
# Há duas APIs possíveis, escolhidas automaticamente pelo prefixo do token:
#  - Instagram Login  → token "IGAA…" → graph.instagram.com → IG_USER_ID não é
#    preciso (o token já identifica a conta).
#  - Facebook Login for Business → token "EAA…" → graph.facebook.com → aí sim,
#    IG_USER_ID tem de ser o IG Business Account ID (conta ligada a uma Página).
IG_ACCESS_TOKEN=""        # token de longa duração (60 dias, renovável)
IG_USER_ID=""             # só para o fluxo do Facebook Login
IG_GRAPH_VERSION="v21.0"
IG_GRAPH_HOST=""          # força o host, se a deteção automática falhar

# SEO — opcional
NEXT_PUBLIC_SITE_URL="https://www.nacional-2.pt/"        # URL canónico de produção (ex: https://www.nacional2.pt)
GOOGLE_SITE_VERIFICATION=""    # meta de verificação do Google Search Console
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/nacional2.pt/"   # perfil oficial (entra no schema Organization.sameAs)

# Application
NODE_ENV="development"
